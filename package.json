{
  "name": "talkee",
  "private": true,
  "version": "0.4.8",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.2.13",
  "scripts": {
    "prepare": "lefthook install",
    "prepare:ffmpeg-sidecar": "bun scripts/prepare-ffmpeg-sidecar.mjs",
    "prepare:stt-sidecar": "bun scripts/prepare-stt-sidecar.mjs",
    "prepare:sidecars": "bun run prepare:ffmpeg-sidecar && bun run prepare:stt-sidecar",
    "dev": "bun scripts/run-vite.mjs",
    "build": "tsc && bun scripts/run-vite.mjs build",
    "gate": "bun scripts/gate.mjs",
    "icons": "bun scripts/generate-icons.mjs",
    "format": "biome format --write . && cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "lint": "biome lint .",
    "test": "bun test",
    "version:current": "pvs current",
    "version:check": "pvs check",
    "version:patch": "pvs bump patch --commit --tag",
    "version:minor": "pvs bump minor --commit --tag",
    "version:major": "pvs bump major --commit --tag",
    "check:changelog": "bun scripts/check-changelog.mjs",
    "check:network": "bun scripts/check-network-hosts.mjs",
    "check:naming": "bun scripts/check-naming.mjs",
    "check:agents-docs": "bun scripts/check-agents-docs.mjs",
    "check:repo": "bun scripts/check-repo.mjs",
    "check:release": "bun run gate && bun run build",
    "postprocess:macos-release": "VERSION=$(python3 -c \"import json; print(json.load(open('package.json'))['version'])\") && BUILD_ROOT=src-tauri/target/release/bundle bash scripts/postprocess-macos-release.sh \"$VERSION\"",
    "build:release": "bun scripts/build-release.mjs",
    "build:release:macos": "bun scripts/build-release.mjs macos",
    "preview": "bun scripts/run-vite.mjs preview",
    "tauri": "bun scripts/run-tauri.mjs",
    "logs": "tail -f ~/.talkee/talkee.log",
    "logs:clear": "rm -f ~/.talkee/talkee.log"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@dibrovnik/pvs": "0.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.4.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "lefthook": "2.1.15",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
