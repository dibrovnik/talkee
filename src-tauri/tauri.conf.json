{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talkee",
  "mainBinaryName": "talkee",
  "version": "../package.json",
  "identifier": "com.talkee.app",
  "build": {
    "beforeDevCommand": "bun scripts/run-vite.mjs --talkee-check-dev-port && bun run dev",
    "devUrl": "http://localhost:14320",
    "beforeBuildCommand": "bun scripts/before-tauri-build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Talkee",
        "url": "index.html?window=widget",
        "width": 129,
        "height": 54,
        "minWidth": 18,
        "minHeight": 18,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "shadow": false,
        "x": 682,
        "y": 800
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": [
      "binaries/talkee-ffmpeg",
      "binaries/talkee-stt",
      "binaries/talkee-diarize",
      "binaries/talkee-llm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.0"
    }
  }
}
